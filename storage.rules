rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null;
    }

    // Only the explicitly provisioned owner account can administer storage.
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'owner' ||
        (firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid)) &&
          firestore.get(/databases/(default)/documents/admins/$(request.auth.uid)).data.role == 'owner')
      );
    }

    // KYC documents (Aadhaar photo, PAN photo, Selfie)
    // Members can upload and read only files under their own UID; the owner can review all KYC files.
    match /kyc/{plumberId}/{fileName} {
      allow write: if isAuthenticated() && request.auth.uid == plumberId
                   && request.resource.size < 10 * 1024 * 1024 // 10MB limit
                   && request.resource.contentType.matches('image/.*');
      allow read: if isAdmin() || (isAuthenticated() && request.auth.uid == plumberId);
      allow delete: if isAdmin();
    }

    // Public/Promotional banner images
    match /banners/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Reward catalogue item images
    match /catalogue/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Bill copies uploaded during point crediting
    match /bills/{fileName} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
  }
}
