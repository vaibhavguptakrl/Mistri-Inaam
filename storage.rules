rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if the caller is an admin via custom token or document lookup
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'owner' ||
        request.auth.token.role == 'staff' ||
        firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid))
      );
    }

    // KYC documents (Aadhaar photo, PAN photo, Selfie)
    // Plumbers can upload their own files; only Admins can view or download them.
    match /kyc/{plumberId}/{fileName} {
      allow write: if isAuthenticated() && request.auth.uid == plumberId
                   && request.resource.size < 10 * 1024 * 1024 // 10MB limit
                   && request.resource.contentType.matches('image/.*');
      allow read: if isAdmin();
      allow delete: if isAdmin();
    }

    // Public/Promotional banner images
    match /banners/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Reward catalogue item images
    match /catalogue/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Bill copies uploaded during point crediting
    match /bills/{fileName} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
  }
}
