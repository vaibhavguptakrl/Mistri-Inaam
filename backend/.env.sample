APP_NAME=BackendBoilerplate

NODE_ENV=development
PORT=8080

ORIGIN=*

# Database: sqlite (a file, nothing to install) or postgres.
# `npm run setup` fills all of this in for you.
DB_DIALECT=sqlite
DB_STORAGE=data/database.sqlite

# Postgres via one connection string (Supabase: use the "Session pooler" URI).
# When set, it replaces the DB_* host/user/password settings below.
DATABASE_URL=
DB_SSL=false

# Postgres via host/user/password (local or Docker).
DB_READ_HOST=127.0.0.1
DB_WRITE_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=backend_boilerplate

FRONTEND_URL=http://localhost:5173

# Redis is optional: leave REDIS_URL and REDIS_DB_HOST empty to run without it.
# Hosted Redis (Upstash, ...): REDIS_URL=rediss://...   Docker: REDIS_DB_HOST=127.0.0.1
REDIS_URL=
REDIS_DB_PASSWORD=
REDIS_DB_HOST=
REDIS_DB_PORT=6379

JWT_LOGIN_SECRET=change-me
JWT_LOGIN_TOKEN_EXPIRY=2d

SOCKET_ENCRYPTION_KEY=change-me
SOCKET_MAX_PER_USER_CONNECTION=2

RATE_LIMIT_OPT_TIMEWINDOW=2
RATE_LIMIT_OPT_MAX_REQUESTS=5
LOG_LEVEL=debug
