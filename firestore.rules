rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isUser(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // An admin record only grants access when its role is explicitly authorized.
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'owner' ||
        request.auth.token.role == 'staff' ||
        (exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
          (get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'owner' ||
           get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'staff'))
      );
    }

    function isOwner() {
      return isAuthenticated() && (
        request.auth.token.role == 'owner' ||
        (exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'owner')
      );
    }

    // Admins collection
    match /memberPhoneIndex/{phoneHash} {
      allow read, write: if false;
    }

    match /admins/{adminId} {
      allow read: if isAdmin() || isUser(adminId);
      allow write: if isOwner();
    }

    // Plumbers collection
    match /plumbers/{plumberId} {
      // Full profiles contain contact and KYC fields; only the owner and staff can read all profiles.
      // Members may read only their own profile. Leaderboard/referral views use callable projections.
      allow read: if isAdmin() || isUser(plumberId);
      
      // Plumber can create their initial profile upon Phone Auth registration
      allow create: if isUser(plumberId)
        && request.resource.data.kycStatus == 'pending'
        && request.resource.data.pointsBalance >= 0;
        
      // Plumbers can update non-critical profile fields (preferences, FCM token, PIN)
      // Balance, plumber code, and KYC status can ONLY be updated by Admins
      allow update: if isAdmin() || (
        isUser(plumberId)
        && request.resource.data.pointsBalance == resource.data.pointsBalance
        && request.resource.data.kycStatus == resource.data.kycStatus
        && request.resource.data.accountStatus == resource.data.accountStatus
        && request.resource.data.plumberCode == resource.data.plumberCode
      );

      allow delete: if isOwner();
    }

    // Ledger transactions (points history)
    match /transactions/{transactionId} {
      // Plumbers can only read transactions addressed to them; Admins can read all
      allow read: if isAdmin() || (
        isAuthenticated() && resource.data.plumberId == request.auth.uid
      );

      // Transactions are written by admins, or welcome bonus on registration
      allow create: if isAdmin() || (
        isAuthenticated() && request.resource.data.plumberId == request.auth.uid && request.resource.data.type == 'welcome_bonus'
      );

      allow update, delete: if isOwner();
    }

    // Redemption requests
    match /redemptionRequests/{requestId} {
      allow read: if isAdmin() || (
        isAuthenticated() && resource.data.plumberId == request.auth.uid
      );

      // Plumbers can create requests for themselves in pending status
      allow create: if (
        isAuthenticated() && request.resource.data.plumberId == request.auth.uid
      ) && request.resource.data.status == 'pending';

      // Only admins can approve, reject, or mark paid
      allow update: if isAdmin();
      allow delete: if isOwner();
    }

    // Catalogue of rewards (vouchers, tools, mechanical items)
    match /catalogue/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Schemes and promotions
    match /schemes/{schemeId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Points calculation rules (category and brand wise)
    match /pointRules/{ruleId} {
      allow read: if isAuthenticated();
      allow write: if isOwner();
    }

    // Categories and brands
    match /categories/{categoryId} {
      allow read: if isAuthenticated();
      allow write: if isOwner();
    }

    match /brands/{brandId} {
      allow read: if isAuthenticated();
      allow write: if isOwner();
    }

    match /festivals/{festivalId} {
      allow read: if isAuthenticated();
      allow write: if isOwner();
    }

    // App Settings (general, features, whatsapp, etc.)
    match /appSettings/{settingDoc} {
      // Maintenance status is a public, non-sensitive app availability flag and
      // must be readable before members sign in so maintenance can cover login/signup.
      allow read: if isAuthenticated() || settingDoc == 'maintenance';
      allow write: if isOwner();
    }

    // Notifications (in-app messages for plumbers)
    match /notifications/{notificationId} {
      allow read: if isAdmin() || (
        isAuthenticated() && resource.data.plumberId == request.auth.uid
      );
      allow create: if isAdmin();
      allow update: if isUser(resource.data.plumberId) || isAdmin();
      allow delete: if isAdmin();
    }

    // Notification Queue (Cloud functions / background queue)
    match /messageQueue/{messageId} {
      allow read, write: if isAdmin();
    }

    // Message templates for Push & WhatsApp
    match /messageTemplates/{templateId} {
      allow read, write: if isAdmin();
    }

    // Deletion requests are created only by the authenticated callable function.
    // Users can see their own request status; staff can review and process requests.
    match /accountDeletionRequests/{uid} {
      allow read: if isAdmin() || isUser(uid);
      allow write: if false;
    }

    // Audit logs of all admin actions
    match /auditLogs/{logId} {
      allow read, create: if isAdmin();
      allow update, delete: if false; // Immutable audit trail
    }
  }
}
